{
  "name": "pi-show-herdr",
  "version": "0.2.0",
  "description": "A Pi tool for reviewing generated output in Herdr",
  "license": "MIT",
  "repository": "github:spoj/pi-show-herdr",
  "homepage": "https://github.com/spoj/pi-show-herdr#readme",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test test/review.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@types/node": "^22.19.19",
    "typebox": "^1.3.7",
    "typescript": "^5.9.3"
  }
}
